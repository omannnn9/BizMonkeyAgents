# Supabase (public — safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-only)
ANTHROPIC_API_KEY=

# Voyage AI embeddings (server-only)
VOYAGE_API_KEY=

# Sentry (set once the app has its first deployment)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
