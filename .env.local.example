# No login — the app always talks to Supabase server-side as the service
# role (see lib/supabase/server.ts). NEXT_PUBLIC_SUPABASE_URL is safe to
# expose (it's just the project endpoint); the service role key must never
# reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed to run scripts/test-rls-isolation.ts (the RLS defense-in-depth
# test — the app itself doesn't use the anon key at all).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (server-only)
ANTHROPIC_API_KEY=

# Voyage AI embeddings (server-only)
VOYAGE_API_KEY=

# Sentry — DSNs are not secret (safe to commit/expose), project already
# created (org: odax, project: od-group-cockpit). Add both to Vercel too.
SENTRY_DSN=https://d3aad08f53dd6798206161be05e65e6c@o4512074042245120.ingest.de.sentry.io/4512074410950736
NEXT_PUBLIC_SENTRY_DSN=https://d3aad08f53dd6798206161be05e65e6c@o4512074042245120.ingest.de.sentry.io/4512074410950736
